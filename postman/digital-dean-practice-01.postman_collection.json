{
  "info": {
    "name": "Digital Dean Practice 01 Variant 3",
    "description": "Номер 15, варіант 3. Запускати всі 20 запитів послідовно. Кожен запуск створює унікальні навчальні email.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "student_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('exact health body', () => pm.expect(pm.response.json()).to.eql({status: 'ok'}));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Олена Коваль\",\n  \"email\": \"{{student_email}}\",\n  \"group_code\": \"КН-31\",\n  \"academic_status\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.variables.replaceIn('{{$guid}}');",
              "pm.collectionVariables.set('run_token', token);",
              "pm.collectionVariables.set('student_email', 'student+' + token + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('server UUID', () => pm.expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i));",
              "pm.test('exact allowed fields', () => pm.expect(body).to.have.all.keys('id','full_name','email','group_code','academic_status'));",
              "pm.test('create payload preserved', () => { pm.expect(body.full_name).to.eql('Олена Коваль'); pm.expect(body.group_code).to.eql('КН-31'); pm.expect(body.academic_status).to.eql('active'); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('student_id', body.id); pm.collectionVariables.set('before', JSON.stringify(body)); pm.collectionVariables.set('duplicate_email', body.email.toUpperCase()); }"
            ]
          }
        }
      ]
    },
    {
      "name": "03 List students",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/students"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('list includes created student', () => { const body=pm.response.json(); pm.expect(body).to.be.an('array'); pm.expect(body.some(s=>s.id===pm.collectionVariables.get('student_id'))).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Get student",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/students/{{student_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('full representation matches creation', () => pm.expect(pm.response.json()).to.eql(JSON.parse(pm.collectionVariables.get('before'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Missing UUID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/students/00000000-0000-4000-8000-000000000000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));",
              "pm.test('controlled error', () => { pm.expect(pm.response.json().detail.code).to.eql('student_not_found'); pm.expect(pm.response.text()).not.to.include('Traceback'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Partial update",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students/{{student_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"group_code\": \"КН-32\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const expected = JSON.parse(pm.collectionVariables.get('before')); expected.group_code='КН-32';",
              "pm.test('only supplied field changes', () => pm.expect(pm.response.json()).to.eql(expected));",
              "pm.collectionVariables.set('after', JSON.stringify(expected));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Malformed JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students",
        "body": {
          "mode": "raw",
          "raw": "{\"full_name\":",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 422', () => pm.response.to.have.status(422));",
              "pm.test('JSON validation error', () => pm.expect(pm.response.json().detail[0].type).to.eql('json_invalid'));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Reject is_admin",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students/{{student_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_admin\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 422', () => pm.response.to.have.status(422));",
              "pm.test('unknown field rejected', () => pm.expect(pm.response.json().detail[0].type).to.eql('extra_forbidden'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Filter academic_status",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/students?academic_status=active"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('filter has target and no mismatches', () => { const body=pm.response.json(); pm.expect(body.some(s=>s.id===pm.collectionVariables.get('student_id'))).to.eql(true); pm.expect(body.every(s=>s.academic_status==='active')).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Олена Коваль\",\n  \"email\": \"{{duplicate_email}}\",\n  \"group_code\": \"КН-31\",\n  \"academic_status\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 409', () => pm.response.to.have.status(409));",
              "pm.test('case insensitive duplicate', () => pm.expect(pm.response.json().detail.code).to.eql('duplicate_email'));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Empty PATCH",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students/{{student_id}}",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 422', () => pm.response.to.have.status(422));",
              "pm.test('empty update rejected', () => pm.expect(pm.response.json().detail[0].type).to.eql('value_error'));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Unknown academic status",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Олена Коваль\",\n  \"email\": \"{{student_email}}\",\n  \"group_code\": \"КН-31\",\n  \"academic_status\": \"unknown\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 422', () => pm.response.to.have.status(422));",
              "pm.test('enum validation error', () => pm.expect(pm.response.json().detail[0].loc).to.eql(['body','academic_status']));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Update academic status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students/{{student_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"academic_status\": \"academic_leave\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const expected=JSON.parse(pm.collectionVariables.get('after')); expected.academic_status='academic_leave';",
              "pm.test('status changes without replacing record', () => pm.expect(pm.response.json()).to.eql(expected));",
              "pm.collectionVariables.set('after', JSON.stringify(expected));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Filter changed status",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/students?academic_status=academic_leave"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('new status visible in filter', () => { const body=pm.response.json(); pm.expect(body.some(s=>s.id===pm.collectionVariables.get('student_id'))).to.eql(true); pm.expect(body.every(s=>s.academic_status==='academic_leave')).to.eql(true); });"
            ]
          }
        }
      ]
    },
