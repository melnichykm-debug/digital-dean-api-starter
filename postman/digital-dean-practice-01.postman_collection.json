    {
      "name": "18 Create second student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Олена Коваль\",\n  \"email\": \"second+{{run_token}}@example.com\",\n  \"group_code\": \"КН-31\",\n  \"academic_status\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.test('second UUID differs', () => pm.expect(pm.response.json().id).not.to.eql(pm.collectionVariables.get('student_id')));",
              "pm.collectionVariables.set('second_email', pm.response.json().email);"
            ]
          }
        }
      ]
    },
    {
      "name": "19 Email conflict on PATCH",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/students/{{student_id}}",
        "body": {
          "mode": "raw",
