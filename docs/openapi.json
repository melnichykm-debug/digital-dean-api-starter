{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Dean API",
    "description": "Практична робота 1. Номер у списку 15, варіант 3 — academic_status.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/students": {
      "post": {
        "tags": [
          "students"
        ],
        "summary": "Create Student",
        "description": "Створити студента з новим серверним UUID.",
        "operationId": "create_student_api_v1_students_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentRead"
                }
              }
            }
          },
          "409": {
            "description": "Email уже використовується",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "students"
        ],
        "summary": "List Students",
        "description": "Повернути список або точний збіг за academic_status.",
        "operationId": "list_students_api_v1_students_get",
        "parameters": [
          {
            "name": "academic_status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/AcademicStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Academic Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StudentRead"
                  },
                  "title": "Response List Students Api V1 Students Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/students/{student_id}": {
      "get": {
        "tags": [
          "students"
        ],
        "summary": "Get Student",
        "operationId": "get_student_api_v1_students__student_id__get",
        "parameters": [
          {
            "name": "student_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Student Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentRead"
                }
              }
            }
          },
          "404": {
            "description": "Студента не знайдено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "students"
        ],
        "summary": "Update Student",
        "description": "Змінити тільки передані дозволені поля; {} та null відхиляються.",
        "operationId": "update_student_api_v1_students__student_id__patch",
        "parameters": [
          {
            "name": "student_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Student Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentRead"
                }
              }
            }
          },
          "404": {
            "description": "Студента не знайдено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Email уже використовується",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcademicStatus": {
        "type": "string",
        "enum": [
          "active",
          "academic_leave",
          "graduated",
          "expelled"
        ],
        "title": "AcademicStatus",
        "description": "Явний навчальний перелік станів."
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "StudentCreate": {
        "properties": {
          "full_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 5,
            "title": "Full Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "group_code": {
            "type": "string",
            "pattern": "^[A-ZА-ЩЬЮЯЄІЇҐ0-9]+-[0-9]{2}$",
            "title": "Group Code"
          },
          "academic_status": {
            "$ref": "#/components/schemas/AcademicStatus"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "full_name",
          "email",
          "group_code",
          "academic_status"
        ],
        "title": "StudentCreate"
      },
      "StudentRead": {
        "properties": {
          "full_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 5,
            "title": "Full Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "group_code": {
            "type": "string",
            "pattern": "^[A-ZА-ЩЬЮЯЄІЇҐ0-9]+-[0-9]{2}$",
            "title": "Group Code"
          },
          "academic_status": {
            "$ref": "#/components/schemas/AcademicStatus"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "full_name",
          "email",
          "group_code",
          "academic_status",
          "id"
        ],
        "title": "StudentRead"
      },
      "StudentUpdate": {
        "properties": {
          "full_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 5,
            "title": "Full Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "group_code": {
            "type": "string",
            "pattern": "^[A-ZА-ЩЬЮЯЄІЇҐ0-9]+-[0-9]{2}$",
            "title": "Group Code"
          },
          "academic_status": {
            "$ref": "#/components/schemas/AcademicStatus",
            "title": "Academic Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "StudentUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
